# ============================================================
# WCD Detailing — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://warringtoncardetailing.co.uk

# ── Database (PostgreSQL) ──────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/wcd_detailing?schema=public

# ── Auth.js (NextAuth v5) ──────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Set to http://localhost:3000 for local dev, full URL in production
NEXTAUTH_URL=http://localhost:3000

# ── Supabase (Booking Enquiries) ──────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service Role key — server-only, NEVER expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────
# Use test keys during development, live keys in production only
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Deposit amount as percentage (e.g. 25 = 25%)
STRIPE_DEPOSIT_PERCENT=25

# ── UploadThing (file uploads) ─────────────────────────────
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=...

# ── Resend (transactional email) ──────────────────────────
RESEND_API_KEY=re_...
# Must match a verified domain in your Resend account
EMAIL_FROM=bookings@warringtoncardetailing.co.uk
EMAIL_ADMIN=admin@warringtoncardetailing.co.uk

# ── Google Analytics / GTM (existing) ─────────────────────
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Google Search Console / Bing (existing) ───────────────
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ── Google Maps (existing) ─────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Rate limiting (Upstash Redis — optional but recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron jobs ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Used to authenticate /api/cron/* endpoints from Vercel Cron
CRON_SECRET=

# ── Application settings ───────────────────────────────────
# Timezone for all scheduling logic
TZ=Europe/London
